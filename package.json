{
  "name": "exam-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Professional Mock Examination Platform (Next.js + TypeScript + SQLite via node:sqlite)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:create": "node prisma/init-db.cjs",
    "db:migrate": "node prisma/migrate.cjs",
    "db:seed": "node prisma/seed.cjs",
    "db:reset": "node prisma/reset.cjs",
    "db:setup": "npm run db:create && npm run db:seed",
    "db:migrate:randomized": "node --env-file=.env scripts/migrate-randomized-exam.cjs",
    "db:seed:bc1000": "node --env-file=.env scripts/seed-behavioral-1000.cjs",
    "db:seed:mock2": "node --env-file=.env scripts/seed-mock-exam-2.cjs",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^2.4.3",
    "cookie": "^0.7.2",
    "jose": "^6.0.10",
    "next": "14.2.23",
    "pg": "^8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.23",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.3.2",
    "typescript": "^5.7.3"
  }
}
